# Renombra este fichero a .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

# URL base de Salesforce (sin barra final)
SF_URL=https://login.salesforce.com

# Sufijo del site (dejar vacío si no aplica)
SF_SITE=

# Credenciales de la Connected App (OAuth2 client_credentials)
SF_CLIENT_ID=tu_consumer_key_aqui
SF_CLIENT_SECRET=tu_consumer_secret_aqui

# Versión de la REST API de Salesforce
SF_API_VERSION=60.0
