# ============================================================
# .env — Credenciales para el entorno de PRODUCCIÓN
# ============================================================
# INSTRUCCIONES:
#   1. Copia este fichero: cp .env.template .env
#   2. Rellena los valores <...> con las credenciales reales
#   3. chmod 600 .env
#   4. NUNCA subas .env a git ni lo compartas por email
# ============================================================

# Oracle — Producción
# (Solicitar a infraestructura)
ORA_HOST=<host-oracle-pro>
ORA_PORT=1521
ORA_SERVICE=<service-pro>
ORA_USER=<usuario-batch-pro>
ORA_SCHEMA=<esquema-propietario-pro>
ORA_PASSWORD=<password-pro>

# Salesforce — Producción
# (Solicitar a Usoa — Connected App de producción, NO del sandbox)
SF_URL=<https://tu-org.my.salesforce.com>
SF_SITE=
SF_CLIENT_ID=<consumer-key-connected-app-pro>
SF_CLIENT_SECRET=<consumer-secret-connected-app-pro>
SF_API_VERSION=60.0

# Campos Salesforce — no cambiar
SF_PROB_FIELD=NU_Probabilidad_de_matricula__c
SF_CONF_FIELD=ProbabilityConfidence__c
